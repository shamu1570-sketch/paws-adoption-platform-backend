# ==============================
# Aplicación
# ==============================
APP_NAME=Huellitas de Amor
APP_ENV=development
# En true, los errores 500 incluyen el detalle técnico en "detailError". Usar false en producción.
DEBUG=true

# Prefijo de todos los endpoints de la API
API_PREFIX=/api/v1

# ==============================
# Base de datos (PostgreSQL de Supabase)
# ==============================
# Supabase cloud  -> Connect > Session pooler, cambiando el prefijo y agregando ?ssl=require:
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:TU_PASSWORD@aws-0-<REGION>.pooler.supabase.com:5432/postgres?ssl=require
# Supabase local  -> `supabase start` (credenciales por defecto del contenedor):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# ==============================
# Supabase Storage (fotos de mascotas)
# ==============================
# Cloud: Project Settings > API. Local: valores que imprime `supabase status`.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# SUPABASE_URL=http://127.0.0.1:54321
# Llave secreta "service_role": solo para el backend, nunca en el frontend ni en Git.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket público donde se guardan las fotos
SUPABASE_STORAGE_BUCKET=pet-photos
# Tamaño máximo por fotografía
MAX_PHOTO_SIZE_MB=5

# ==============================
# CORS
# ==============================
# Orígenes del frontend permitidos, separados por coma
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================
# Autenticación de administradores
# ==============================
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Llave para el alta inicial: registra al primer super_admin y deja de funcionar en cuanto existe uno.
# Los demás se registran con llaves de un solo uso que el super_admin genera en el panel.
ADMIN_REGISTRATION_KEY=
# Horas de vigencia de las llaves de acceso de un solo uso
ADMIN_INVITATION_EXPIRE_HOURS=72

# ==============================
# Correo saliente (Gmail)
# ==============================
# Envía al solicitante su código de seguimiento. Si SMTP_USERNAME o SMTP_PASSWORD están
# vacíos no se envían correos (el código igual se muestra en pantalla).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Cuenta de Gmail que envía los correos
SMTP_USERNAME=
# "Contraseña de aplicación" de 16 caracteres (no es la contraseña de la cuenta).
# Se crea en https://myaccount.google.com/apppasswords con la verificación en dos pasos activa.
SMTP_PASSWORD=
# Nombre visible del remitente
EMAIL_FROM_NAME=Huellitas de Amor
# URL pública del frontend; se usa en el enlace "Consultar el estado" del correo
FRONTEND_URL=http://localhost:3000
